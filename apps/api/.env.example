# Copy to .env for local overrides. Every setting is optional; these are the defaults.
# Never commit .env: only this example file belongs in the repository.

# Port the API listens on (1-65535).
PORT=3001

# Address to bind to. 127.0.0.1 keeps the API local; use 0.0.0.0 inside a container.
HOST=127.0.0.1

# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Runtime mode: development, test or production.
NODE_ENV=development
